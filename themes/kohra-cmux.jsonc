  // Workspace rail chips, mapped to Kohra. 12 are taken straight from the Kohra ANSI palette;
  // Navy, Crimson, Orange and Indigo are derived in OKLCH at L/C matched to the palette normals
  // (L≈0.60, C≈0.10) so they read as siblings rather than imports.
  "workspaceColors" : {
    "indicatorStyle" : "leftRail",
    "colors" : {
      "Blue" : "#3e88b5",
      "Aqua" : "#65c1b5",
      "Teal" : "#1c9388",
      "Olive" : "#768a42",
      "Amber" : "#d2a56d",
      "Red" : "#b46768",
      "Crimson" : "#814346",
      "Green" : "#a4b776",
      "Navy" : "#395a81",
      "Purple" : "#a86893",
      "Brown" : "#a57635",
      "Orange" : "#ae7853",
      "Charcoal" : "#4a4d50",
      "Magenta" : "#d598c0",
      "Indigo" : "#646295",
      "Rose" : "#e19796"
    },
    "selectionColor" : "#3e88b5",
    "notificationBadgeColor" : "#b46768"
  },

  "sidebarAppearance" : {
    "tintColor" : "#181b1d",
    "lightModeTintColor" : null,
    "darkModeTintColor" : "#181b1d",
    "tintOpacity" : 0.2,
    "matchTerminalBackground" : false
  },

  //   "automation" : {
