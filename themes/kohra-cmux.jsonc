{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // Kohra — cmux port.
  // Cool fog-grey monochrome. Colours mirror the Kohra terminal palette (themes/kohra-ghostty).
  // This file keeps the full cmux template scaffold: only the colour-relevant keys are set
  // (app.appearance, workspaceColors, sidebarAppearance, browser.theme); every other section is
  // left commented so it falls back to the value saved in cmux Settings. Uncomment + edit any
  // line to take it over.
  // Install: cp themes/kohra-cmux.json ~/.config/cmux/cmux.json

  "app" : {
    "appearance" : "dark"
    // Remaining app.* keys fall back to Settings. Uncomment to manage:
    //   "reorderOnNotification" : true,
    //   "warnBeforeClosingTabXButton" : false,
    //   "iMessageMode" : false,
    //   "menuBarOnly" : false,
    //   "workspaceInheritWorkingDirectory" : true,
    //   "warnBeforeClosingTab" : true,
    //   "keepWorkspaceOpenWhenClosingLastSurface" : false,
    //   "sendAnonymousTelemetry" : true,
    //   "minimalMode" : false,
    //   "focusPaneOnFirstClick" : false,
    //   "openMarkdownInCmuxViewer" : false,
    //   "newWorkspacePlacement" : "afterCurrent",
    //   "commandPaletteSearchesAllSurfaces" : false,
    //   "language" : "system",
    //   "appIcon" : "automatic",
    //   "openSupportedFilesInCmux" : true,
    //   "hideTabCloseButton" : false,
    //   "confirmQuit" : "always",
    //   "renameSelectsExistingName" : true,
    //   "preferredEditor" : ""
  },

  //   "terminal" : {
